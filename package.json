{
  "name": "pashyanti-3.0",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev worker/index.js --port 8787",
    "worker:deploy": "wrangler deploy worker/index.js",
    "d1:init:local": "wrangler d1 execute pashyanti-db --local --file=./worker/schema.sql",
